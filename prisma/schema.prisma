// AI 写小说平台 Prisma Schema
// 适配 Supabase PostgreSQL

generator client {
  provider        = "prisma-client-js"
  // EdgeOne 构建机是 rhel-openssl-3.0.x，函数运行时是 rhel-openssl-1.1.x，
  // 必须显式声明运行时 binaryTarget，否则部署后找不到 Query Engine 二进制
  binaryTargets   = ["native", "rhel-openssl-1.1.x"]
  // 连接层走纯 JS pg 驱动（adapter 与引擎在 5.22 中协同工作）
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ============ 用户系统 ============

enum UserRole {
  ADMIN
  FREE
  BASIC
  STANDARD
  PRO
  ULTIMATE
}

enum SubscriptionPlan {
  FREE
  BASIC
  STANDARD
  PRO
  ULTIMATE
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  name           String?
  passwordHash   String?
  avatar         String?
  role           UserRole      @default(FREE)
  subscription   Subscription?
  projects       Project[]
  aiUsageLogs    AIUsageLog[]
  accounts       Account[]
  sessions       Session[]
  creditBalance  CreditBalance?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("users")
}

model Subscription {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @unique @db.Uuid
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan    @default(FREE)
  status          SubscriptionStatus  @default(active)
  expiresAt       DateTime?
  renewAt         DateTime?
  paymentProvider String?
  providerSubId   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("subscriptions")
}

// ============ 项目 & 知识库 ============

enum ProjectMode {
  PIPELINE
  WORKBENCH
  CHAT
}

enum ProjectStatus {
  draft
  active
  archived
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  genre       String        @default("都市")
  synopsis    String?
  styleProfile   Json?
  mode        ProjectMode   @default(PIPELINE)
  currentStep Int           @default(1)
  status      ProjectStatus @default(draft)
  wordCount   Int           @default(0)
  coverImage  String?
  model      String?       // 项目级 AI 模型选择，null 时回退到 DEFAULT_MODEL
  targetChapters Int?       // 全书目标章节数（立项时设定，供大纲规划整体节奏）
  chapterWords   Int?       // 每章目标字数（供扩写控制篇幅）
  autoMemory  Boolean       @default(true) // 保存章节后自动提取记忆 wiki（配额不足时静默跳过）
  deletedAt   DateTime?
  worldSettings WorldSetting[]
  characters  Character[]
  outlines    Outline[]
  chapters    Chapter[]
  chatSessions ChatSession[]
  aiUsageLogs AIUsageLog[]
  storyEvents StoryEvent[]
  foreshadows Foreshadow[]
  characterStates CharacterState[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@map("projects")
}

enum WorldSettingCategory {
  BACKGROUND
  GEOGRAPHY
  RULE
  SYSTEM
  OTHER
}

model WorldSetting {
  id          String               @id @default(uuid()) @db.Uuid
  projectId   String               @db.Uuid
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    WorldSettingCategory @default(BACKGROUND)
  title       String
  content     Json
  deletedAt   DateTime?
  version     Int                  @default(1)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([projectId])
  @@map("world_settings")
}

enum CharacterRole {
  PROTAGONIST
  SUPPORTING
  ANTAGONIST
  EXTRA
}

model Character {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  role          CharacterRole @default(SUPPORTING)
  appearance    String?
  personality   String?
  background    String?
  motivation    String?
  arc           String?
  relationships Json          @default("[]")
  characterStates CharacterState[]
  deletedAt   DateTime?
  version     Int                  @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([projectId])
  @@map("characters")
}

model Outline {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  volume          Int      @default(1)
  chapter         Int
  sceneTitle      String
  sceneSummary    String
  povCharacterId  String?  @db.Uuid
  plotPoints      Json     @default("[]")
  foreshadowing   String?
  order           Float    @default(0)
  chapterRecord   Chapter?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@map("outlines")
}

enum ChapterStatus {
  draft
  final
}

model Chapter {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outlineId   String?       @unique @db.Uuid
  outline     Outline?      @relation(fields: [outlineId], references: [id], onDelete: SetNull)
  title       String
  content     String        @default("")
  wordCount   Int           @default(0)
  status      ChapterStatus @default(draft)
  summary     String?
  storyEvents     StoryEvent[]
  foreshadowsPlanted   Foreshadow[] @relation("ForeshadowPlanted")
  foreshadowsResolved  Foreshadow[] @relation("ForeshadowResolved")
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId])
  @@index([projectId, createdAt])
  @@map("chapters")
}

// ============ 记忆 wiki（LLM 提取的结构化故事状态） ============

enum StoryEventSource {
  chapter
  chat
}

enum ForeshadowStatus {
  open
  resolved
  abandoned
}

model StoryEvent {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @db.Uuid
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId   String?          @db.Uuid
  chapter     Chapter?         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterNo   Int              @default(0)
  source      StoryEventSource @default(chapter)
  content     String
  characters  Json             @default("[]")
  key         Boolean          @default(false)
  order       Float            @default(0)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId, chapterNo])
  @@index([chapterId])
  @@map("story_events")
}

model Foreshadow {
  id                String           @id @default(uuid()) @db.Uuid
  projectId         String           @db.Uuid
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  content           String           @default("")
  status            ForeshadowStatus @default(open)
  plantedChapterId  String?          @db.Uuid
  plantedChapter    Chapter?         @relation("ForeshadowPlanted", fields: [plantedChapterId], references: [id], onDelete: SetNull)
  plantedChapterNo  Int?
  resolvedChapterId String?          @db.Uuid
  resolvedChapter   Chapter?         @relation("ForeshadowResolved", fields: [resolvedChapterId], references: [id], onDelete: SetNull)
  resolvedChapterNo Int?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([projectId, status])
  @@index([plantedChapterId])
  @@map("foreshadows")
}

model CharacterState {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterId String    @unique @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  current     Json      @default("{}")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@map("character_states")
}

// 积分余额（积分制：订阅月度积分 + 签到积分）
model CreditBalance {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleKey       String   @default("")   // 当前月度周期 "2026-09"（北京时间）
  monthlyGranted Int      @default(0)    // 本周期订阅发放积分
  monthlyUsed    Int      @default(0)    // 本周期已消耗
  bonusBalance   Int      @default(0)    // 签到积分余额（不清零）
  lastCheckInKey String?                 // 最近签到日 YYYY-MM-DD（北京时间）
  updatedAt      DateTime @updatedAt

  @@map("credit_balances")
}

enum ChatSessionStatus {
  active
  converted
}

model ChatSession {
  id             String            @id @default(uuid()) @db.Uuid
  projectId      String            @db.Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  extractedCards Json              @default("{}")
  branchPoints   Json              @default("[]")
  status         ChatSessionStatus @default(active)
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([projectId])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @db.Uuid
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  timestamp   DateTime    @default(now())
  deletedAt   DateTime?

  @@index([sessionId])
  @@map("chat_messages")
}

enum VersionEntityType {
  chapter
  worldsetting
  character
}

model Version {
  id         String           @id @default(uuid()) @db.Uuid
  entityType VersionEntityType
  entityId   String           @db.Uuid
  snapshot   Json
  label      String?
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())

  @@index([entityType, entityId])
  @@map("versions")
}

enum AIAction {
  inspire
  worldbuild
  character
  outline
  outlineAppend
  expand
  polish
  chat
  consistency
  extract
  summary
  analyzeStyle
}

model AIUsageLog {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?  @db.Uuid
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action           AIAction
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(10, 6)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

// ============ NextAuth ============

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
