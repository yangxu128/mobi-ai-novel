# ============ 数据库 (Supabase) ============
# Supabase 项目设置 > Database > Connection string
# Session pooler (用于 Prisma Client 运行时):
DATABASE_URL="postgresql://postgres.[项目Ref]:[密码]@aws-0-[区域].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (用于 Prisma migrate/push):
DIRECT_URL="postgresql://postgres.[项目Ref]:[密码]@aws-0-[区域].pooler.supabase.com:5432/postgres"

# ============ NextAuth ============
# 生成命令: openssl rand -base64 32
AUTH_SECRET="请生成一个随机字符串"
# 部署地址（本地开发用 http://localhost:3000）
NEXTAUTH_URL="http://localhost:3000"

# ============ GitHub OAuth (可选) ============
# 在 https://github.com/settings/developers 创建 OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============ AI 服务 (OpenAI 兼容) ============
# 可填 OpenAI / 豆包 / DeepSeek / 智谱 等兼容接口
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
# 默认模型名（OpenAI: gpt-4o-mini；豆包: doubao-pro-32k；DeepSeek: deepseek-chat）
AI_MODEL="gpt-4o-mini"

# ============ 应用配置 ============
# 配额为积分制：套餐每日积分定义在 src/lib/ai/credits.ts（免费 5 / 基础 100 / 专业 500）
# 1 积分 ≈ 100 tokens ≈ 100 字；无需在此配置

# 可用模型列表（逗号分隔，展示在模型选择器；不填则用默认列表）
AI_MODELS=""
# 高级模型（可选，展示在模型选择器的"高级"分组）
AI_MODEL_PREMIUM=""

# 生产环境（EdgeOne 等反代后）必须开启，否则登录回调会被 CSRF 拦截
AUTH_TRUST_HOST=true
